# Copy to .env and fill in. Never commit .env.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ringvault
PORT=5000

# https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Comma-separated allowed origins (empty = allow all, fine for mobile-only API)
CORS_ORIGINS=
